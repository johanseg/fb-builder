{
  "name": "tsi-ad-creative-studio",
  "private": true,
  "version": "1.0.0",
  "description": "Townsquare Interactive Ad Creative Studio",
  "author": "Jason Akatiff <jason@jasonakatiff.com> (https://iscale.com)",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "bash tests/agent-browser/run-all.sh",
    "test:smoke": "bash tests/agent-browser/run-all.sh",
    "test:login": "bash tests/agent-browser/smoke-login.sh",
    "test:auth": "bash tests/agent-browser/smoke-auth.sh",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "audit:production": "node scripts/audit-production.mjs",
    "test:all": "npm run test:unit && npm run test:smoke"
  },
  "dependencies": {
    "express": "^5.1.0",
    "lucide-react": "^0.554.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "7.18.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "@vitest/coverage-v8": "^4.1.5",
    "autoprefixer": "^10.4.17",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-plugin-security": "^2.1.0",
    "globals": "^16.5.0",
    "jsdom": "^24.0.0",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.1",
    "vite": "7.3.5",
    "vitest": "^4.1.5"
  },
  "overrides": {
    "brace-expansion": "1.1.16",
    "form-data": "4.0.6",
    "js-yaml": "4.3.0",
    "ws": "8.21.0",
    "esbuild": "0.28.1"
  }
}
